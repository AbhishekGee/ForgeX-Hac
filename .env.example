# Claude (prescription reading + instruction drafting)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Shared state for shops/orders. Add the Upstash Redis integration on Vercel,
# it sets these (or KV_REST_API_URL / KV_REST_API_TOKEN). Without them the app
# falls back to in-memory state, which resets on every cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: require this PIN on the shopkeeper page
SHOP_PIN=

# Optional: n8n integration
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
